# Copia este archivo como .env y rellena los valores. El .env no se sube al repositorio.

# Serenity (solo lectura)
SERENITY_BASE_URL=https://api.serenitystar.ai
SERENITY_API_KEY=
SERENITY_AGENT_CODE=

# Carpeta de datos local (base SQLite y JSON originales). Por defecto ./data
# LOCAL_DATA_DIR=

# API local
# mock: datos ficticios | db: base local de la ingesta
API_BACKEND=db
# Token fijo en lugar de Cognito. Vacío: se acepta cualquier token (modo de prueba)
API_TOKEN=
# Credenciales del endpoint de tokens simulado (/mock/oauth2/token), para el botón Authorize de /docs
API_CLIENT_ID=
API_CLIENT_SECRET=
# Lectura síncrona contra Serenity antes de responder (true por defecto)
# API_SYNC_ON_DEMAND=true
